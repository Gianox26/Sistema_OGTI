# Configuración de entorno para Sistema OGTI
# Copia este archivo a ".env" y completa los valores.

# API key de Firecrawl (https://firecrawl.dev) — plan gratuito disponible.
# Con esta key el sistema obtiene especificaciones REALES de la web (renderizado JS)
# para cualquier marca/modelo. Sin ella, se usa un buscador de mejor esfuerzo (Bing)
# que funciona solo cuando la página del fabricante/expendedor tiene las specs en HTML plano.
FIRECRAWL_API_KEY=

SECRET_KEY=ogti-san-roman-juliaca-2026-dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_ogti
DB_USER=fulanito
DB_PASSWORD=ogti2026
